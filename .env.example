# ============================================================================
# AI Security Gateway - Environment Configuration
# ============================================================================

# === Gateway Configuration ===
EXPECTED_GATEWAY_TOKEN=prod-super-secure-token-991
LLAMA_GUARD_ENDPOINT=http://internal.local
LOG_LEVEL=info

# === Redis Configuration ===
REDIS_PASSWORD=redis-secure-password-123
REDIS_MAX_MEMORY=512mb

# === Celery Configuration ===
CELERY_CONCURRENCY=4

# === SSL/TLS Certificates ===
# Place your certificates in ./certs/ directory:
# - server.key
# - server.crt
# - ca.crt

# === Docker Resources (optional) ===
# Adjust based on your infrastructure capacity
# CELERY_WORKER_CPU_LIMIT=2
# CELERY_WORKER_MEMORY_LIMIT=1G
